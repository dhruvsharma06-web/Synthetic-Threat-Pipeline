# Copy to .env and change every value. .env is gitignored.
DVWA_DB_ROOT_PASSWORD=change-me
DVWA_DB_PASSWORD=change-me
GRAFANA_ADMIN_PASSWORD=change-me

# soc profile only. The wazuh-indexer image ships with admin/admin;
# keep "admin" here unless you also change it inside the indexer.
WAZUH_ENABLED=false
WAZUH_INDEXER_PASSWORD=admin
